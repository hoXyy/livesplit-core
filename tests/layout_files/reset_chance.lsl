<?xml version="1.0" encoding="UTF-8"?>
<Layout>
  <Mode>Vertical</Mode>
  <Settings />
  <Components>
    <Component>
      <Path>LiveSplit.ResetChance.dll</Path>
      <Settings>
        <Version>1.0</Version>
        <TextColor>FFFF0000</TextColor>
        <OverrideTextColor>True</OverrideTextColor>
        <ChanceColor>FF00FF00</ChanceColor>
        <OverrideChanceColor>False</OverrideChanceColor>
        <BackgroundColor>FF0000FF</BackgroundColor>
        <BackgroundColor2>FFFF0000</BackgroundColor2>
        <BackgroundGradient>Horizontal</BackgroundGradient>
        <ChanceMode>SuccessChance</ChanceMode>
        <Accuracy>TwoDecimal</Accuracy>
        <ShowTrailingZeroes>True</ShowTrailingZeroes>
        <Basis>SubsetSplits</Basis>
        <BasisSubset>25</BasisSubset>
        <BasisSubsetSplits>10</BasisSubsetSplits>
        <Display2Rows>True</Display2Rows>
        <FutureSetting>ignored</FutureSetting>
      </Settings>
    </Component>
  </Components>
</Layout>
